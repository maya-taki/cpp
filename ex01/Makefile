CXX = c++
INCLUDE = -I includes
FLAGS = -Wall -Wextra -Werror -std=c++98 $(INCLUDE)

NAME = phonebook

SRC = phonebook.cpp

OBJDIR = obj
OBJ = $(SRC:%.cpp=$(OBJDIR)/%.o)

$(NAME) : $(OBJ)
	@$(CXX) $(FLAGS) $(OBJ) -o $@

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@$(CXX) $(FLAGS) -c $< -o $@
#	@$(call show_progress, $<)

all : $(NAME)

clean:
	@rm -rf $(OBJ)

fclean: clean
	@rm -rf $(NAME)

re: fclean all
